POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=replace-with-strong-password
WMS_SECRET_KEY=replace-with-random-secret
WMS_CORS_ORIGINS=https://wms.example.com,https://servicewechat.com

# Tencent Cloud EdgeOne cache purge. Fill these in deploy/.env only; do not commit real secrets.
TENCENTCLOUD_SECRET_ID=replace-with-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-secret-key
EDGEONE_ZONE_ID=replace-with-zone-id
EDGEONE_PURGE_TYPE=purge_url
EDGEONE_PURGE_TARGETS=https://wms.sky-clemon.top/,https://wms.sky-clemon.top/index.html,https://wms.sky-clemon.top/styles.css,https://wms.sky-clemon.top/app.js
