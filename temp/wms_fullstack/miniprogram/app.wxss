page {
  background: #f4f6f8;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
.container {
  padding: 28rpx;
}
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.muted {
  color: #6b7280;
  font-size: 26rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}
.label {
  color: #6b7280;
}
.value {
  font-weight: 600;
  text-align: right;
}
.btn {
  margin-top: 18rpx;
}
.btn-danger {
  background: #dc2626 !important;
}
.input {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx;
  margin: 18rpx 0;
}
.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
}
